<Project Sdk="Microsoft.NET.Sdk">
    <!-- Text recognition with PP-OCRv6 through ONNX Runtime (KONZEPT.md §5.9). The only project that depends on ONNX Runtime: the core
         knows only its interface (Core/Ocr). -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <IsAotCompatible>true</IsAotCompatible>
        <!-- LibraryImport (setenv of the C library, OnnxRuntimeSetup) -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PdfKnead.Core\PdfKnead.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PdfKnead.Tests" />
        <InternalsVisibleTo Include="pdf-knead" />
    </ItemGroup>
</Project>
