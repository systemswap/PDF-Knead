<Project>
    <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management
         Bewusst wenige Pakete: alles PDF-Spezifische ist eigener Code (KONZEPT.md §1).
         Neue Pakete nur nach Rückfrage und nach Prüfung auf Telemetrie. -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- Avalonia: Versionen gleich halten. Bringt SkiaSharp und HarfBuzzSharp mit. -->
        <PackageVersion Include="Avalonia" Version="12.1.1" />
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
        <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
        <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
        <PackageVersion Include="Avalonia.Headless" Version="12.1.1" />
        <PackageVersion Include="Avalonia.Skia" Version="12.1.1" />
        <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />

        <!-- Skia: dieselbe Fassung, die Avalonia.Skia mitbringt (Renderer, Kommandozeile) -->
        <PackageVersion Include="SkiaSharp" Version="3.119.4" />
        <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
        <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />

        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

        <!-- Digital signatures (CMS/PAdES, KONZEPT.md §5.17): from Microsoft, MIT, no further dependencies under .NET 10,
             no telemetry; checked to run under Native AOT -->
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />

        <!-- Text recognition (KONZEPT.md §5.9): ONNX Runtime from Microsoft, MIT. The Windows packages send telemetry by default (ETW):
             switched off at start (OrtEnv.DisableTelemetryEvents, PdfKnead.Ai). Approved by the user (18.10.2026, again 30.10.2026). -->
        <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />

        <!-- Tests -->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
        <!-- Only in the tests, as a cross-check of the own XML signature code for the EU trusted lists (KONZEPT.md §5.17): from
             Microsoft, MIT, no telemetry; approved by the user (1.11.2026). Not part of the program. -->
        <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    </ItemGroup>
</Project>
