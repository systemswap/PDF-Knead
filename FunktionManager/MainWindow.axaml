<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:FunktionManager"
        x:Class="FunktionManager.MainWindow"
        Title="PDF-Knead – FunktionManager"
        Width="1000" SizeToContent="Height" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        FontSize="12"
        Background="{DynamicResource Fine.WindowBackground}"
        Foreground="{DynamicResource Fine.TextPrimary}"
        Icon="/Assets/app.ico">
    <Window.Styles>
        <StyleInclude Source="/Fine.axaml" />
    </Window.Styles>

    <DockPanel>
        <!-- head -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="24,16,24,8">
            <Image Source="/Assets/Icon.png" Width="30" Height="30" VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="Berechtigungen verwalten" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="PDF-Knead · Funktionsdatei für die Rechner einer Organisation" Classes="hint" />
            </StackPanel>
        </Grid>

        <!-- foot -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Fine.CardBorder}"
                Background="{DynamicResource Fine.CardBackground}" Padding="24,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Name="StatusText" Classes="hint" Margin="0,0,14,0" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="Schließen" Click="OnClose" IsCancel="True" MinWidth="96" />
            </Grid>
        </Border>

        <!-- the editor scrolls its content itself and keeps its buttons in sight -->
        <local:PolicyEditor Name="Editor" />
    </DockPanel>
</Window>
