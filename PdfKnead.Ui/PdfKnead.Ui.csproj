<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>PdfKnead</RootNamespace>
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
        <AvaloniaResource Include="Styles\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <!-- Zugriff auf die Skia-Leinwand beim Zeichnen der Kacheln (ISkiaSharpApiLeaseFeature) -->
        <PackageReference Include="Avalonia.Skia" />
    </ItemGroup>

    <!-- License texts for the window „Über PDF-Knead“: exactly what ships with the program; the own license once the file LICENSE exists -->
    <ItemGroup>
        <EmbeddedResource Include="..\THIRD-PARTY-NOTICES.md" LogicalName="Lizenzen/THIRD-PARTY-NOTICES.md" />
        <EmbeddedResource Include="..\LICENSE" LogicalName="Lizenzen/LICENSE" Condition="Exists('..\LICENSE')" />
        <EmbeddedResource Include="..\packaging\licenses\*;..\Schriften\Standard\Lizenzen\*;..\Schriften\Handschriften-frei\Lizenzen\*"
                          LogicalName="Lizenzen/Texte/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PdfKnead.Core\PdfKnead.Core.csproj" />
        <ProjectReference Include="..\PdfKnead.Rendering\PdfKnead.Rendering.csproj" />
        <ProjectReference Include="..\PdfKnead.Ai\PdfKnead.Ai.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PdfKnead.Tests" />
    </ItemGroup>
</Project>
