<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Allgemeine Stile. Farben nur über die Tokens (Tokens.axaml).
         Achtung: Stile hier gelten global — Selektoren mit Klasse eng halten. -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <!-- ===================================================================
         Texte
         =================================================================== -->
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.small">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.hero">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeHero}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="LetterSpacing" Value="0.4" />
    </Style>

    <!-- ===================================================================
         Gegliederte Tooltips (Festlegung vom 8.11.2026, zuerst beim Messen): fett die Überschrift, ein Satz, was es tut,
         dann eine Tabelle — links kurz, was entsteht, rechts, wie es geht —, Gruppen durch eine Leerzeile getrennt (eine Zeile der
         Tabelle, damit die Spalten bündig bleiben)
         =================================================================== -->
    <Style Selector="StackPanel.tip">
        <Setter Property="Spacing" Value="8" />
        <Setter Property="MaxWidth" Value="300" />
    </Style>
    <Style Selector="StackPanel.tip TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="StackPanel.tip TextBlock.tipTitle">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Grid.tipKeys">
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="RowSpacing" Value="4" />
    </Style>
    <Style Selector="Grid.tipKeys TextBlock.tipKey">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- ===================================================================
         Knöpfe: primary (Akzent), subtle (flach)
         =================================================================== -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <!-- leicht in der Akzentfarbe: Nebenaktion in einem Bereich, deutlich als Knopf erkennbar (hell und dunkel aus den Tokens) -->
    <Style Selector="Button.soft">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.soft:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.soft:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <Style Selector="Button.soft.small">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    </Style>

    <!-- rot gefüllt: etwas endgültig entfernen oder einen Modus beenden, auf hellem wie auf rötlichem Grund erkennbar -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Button.danger.small">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    </Style>

    <!-- leicht orange: etwas, das laufende Arbeit beendet -->
    <Style Selector="Button.softWarn">
        <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>
    <Style Selector="Button.softWarn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource WarnBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.softWarn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource WarnBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <Style Selector="Button.subtle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.subtle:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
    </Style>
    <Style Selector="Button.subtle.small">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- ===================================================================
         Ribbon-Reiter (Start, Seiten …): Text, darunter ein Akzentstrich beim gewählten
         =================================================================== -->
    <Style Selector="Button.ribbonTab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <ContentPresenter Name="PART_Text" Content="{TemplateBinding Content}"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" FontWeight="Medium" />
                    <Border Name="PART_Underline" Height="3" CornerRadius="2,2,0,0"
                            VerticalAlignment="Bottom" Margin="10,0"
                            Background="{DynamicResource AccentBrush}" IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.ribbonTab:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.ribbonTab.selected">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.ribbonTab.selected /template/ Border#PART_Underline">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- „Datei“: gefüllt in der Akzentfarbe, öffnet den Datei-Bereich -->
    <Style Selector="Button.fileTab">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="Margin" Value="8,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.fileTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <!-- ===================================================================
         Datei-Bereich (Backstage): Navigation links
         =================================================================== -->
    <Style Selector="Button.backstageNav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="20,9" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.backstageNav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#26FFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.backstageNav.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.backstageNav:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#8CFFFFFF" />
    </Style>

    <!-- ===================================================================
         Karten, Seitenleiste, Dokument-Reiter
         =================================================================== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowCard}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style Selector="ListBox.recent">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.recent ListBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>

    <!-- Seitenliste in der Seitenleiste -->
    <Style Selector="ListBox.pages">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,6" />
    </Style>
    <Style Selector="ListBox.pages ListBoxItem">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="10,2" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.pages ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>

    <!-- Auswahl als Liste von Karten (PDF-Version beim Speichern unter) -->
    <Style Selector="ListBox.choices">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.choices ListBoxItem">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>
    <Style Selector="ListBox.choices ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>

    <Style Selector="ListBox.docTabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.docTabs ListBoxItem">
        <Setter Property="Padding" Value="12,6,6,6" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="CornerRadius" Value="8,8,0,0" />
        <Setter Property="MinWidth" Value="120" />
    </Style>
    <Style Selector="ListBox.docTabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    </Style>
    <Style Selector="ListBox.docTabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="ListBox.docTabs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    </Style>

    <Style Selector="Button.closeTab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="Button.closeTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
    </Style>

    <!-- ===================================================================
         Regler: heller Ring mit Akzentpunkt, Maße in Tokens.axaml
         =================================================================== -->
    <Style Selector="Slider /template/ Thumb#thumb">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineStrongBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource SliderThumbCornerRadius}">
                    <Ellipse Name="Dot" Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- Gefüllter Teil in der Akzentfarbe (Fluent nimmt im hellen Design ein Systemblau) -->
    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Slider:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>
    <Style Selector="Slider:pointerover /template/ Thumb#thumb /template/ Ellipse#Dot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
    </Style>
    <Style Selector="Slider:disabled /template/ Thumb#thumb /template/ Ellipse#Dot">
        <Setter Property="Fill" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <Style Selector="GridSplitter.sidebar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="5" />
    </Style>

    <!-- ===================================================================
         Kalender beim Ausfüllen von Datumsfeldern (M6d, Controls/FieldCalendar)
         =================================================================== -->
    <Style Selector="FlyoutPresenter.calendarFlyout">
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="MaxWidth" Value="420" />
    </Style>
    <Style Selector="Border.calHeader">
        <Setter Property="CornerRadius" Value="16,16,0,0" />
        <Setter Property="Padding" Value="18,14,12,14" />
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="{DynamicResource SystemAccentColor}" Offset="0" />
                <GradientStop Color="{DynamicResource SystemAccentColorLight1}" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>
    <Style Selector="Border.calHeader TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.calYear">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="TextBlock.calDate">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Monat mit Pfeilen -->
    <Style Selector="Button.calNav, Button.calTitle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.calNav">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.calTitle">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.calNav:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.calTitle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Wochentage und Kalenderwochen -->
    <Style Selector="TextBlock.calWeekday">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.calWeekday.weekend">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.calWeek">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,5,4,5" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.calWeek TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Tage: rund, beim Darüberfahren sanft hinterlegt -->
    <Style Selector="Button.calDay">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.calDay:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.calDay.weekend">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.calDay.other">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>
    <Style Selector="Button.calDay.today">
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.calDay.focus">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.calDay.selected">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.calDay.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <!-- Monate und Jahre -->
    <Style Selector="Button.calTile">
        <Setter Property="Width" Value="68" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.calTile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.calTile.selected">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.calTile.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <!-- ===================================================================
         Auswahl beim Ausfüllen von Kombinations- und Listenfeldern (M6d)
         =================================================================== -->
    <Style Selector="FlyoutPresenter.choiceFlyout">
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="MaxWidth" Value="480" />
    </Style>
    <!-- Inhalt eines Code-Felds beim Ausfüllen (KONZEPT §5.19, Schritt 4) -->
    <Style Selector="TextBlock.codeInputHint">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="10,6,10,0" />
    </Style>
    <Style Selector="TextBlock.codeInputError">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="10,6,10,0" />
    </Style>
    <Style Selector="TextBlock.choiceHeader">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Margin" Value="10,4,10,6" />
    </Style>
    <Style Selector="Button.choiceItem">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.choiceItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.choiceItem.selected">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.choiceItem.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Path.choiceCheck">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Fuß: „Heute“ als Pille, die übrigen schlicht in der Akzentfarbe -->
    <Style Selector="Button.calToday">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16,6" />
    </Style>
    <Style Selector="Button.calLink">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.calLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

</Styles>
