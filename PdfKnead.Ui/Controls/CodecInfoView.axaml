<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:PdfKnead.Localization"
             xmlns:vm="using:PdfKnead.ViewModels"
             x:Class="PdfKnead.Controls.CodecInfoView"
             x:DataType="vm:CodecInfo">
    <!-- Infobox eines Komprimierverfahrens (KONZEPT §5.12): wann wählen, was es kann, wo es gelesen wird -->
    <UserControl.Styles>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Ellipse.dot.full">
            <Setter Property="Fill" Value="{DynamicResource GoodBrush}" />
        </Style>
        <Style Selector="Ellipse.dot.partial">
            <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
        </Style>
        <Style Selector="Ellipse.dot.none">
            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
        </Style>
    </UserControl.Styles>
    <StackPanel Width="380" Spacing="8" Margin="4">
        <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding Name}" />
        <TextBlock TextWrapping="Wrap" Text="{Binding Description}" />
        <TextBlock Classes="small" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" Text="{Binding Planned}"
                   IsVisible="{Binding !Available}" />
        <TextBlock Classes="section" Text="{l:T 'WO ES GELESEN WIRD'}" Margin="0,6,0,0" />
        <ItemsControl ItemsSource="{Binding Viewers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ViewerSupport">
                    <Grid ColumnDefinitions="16,128,*" Margin="0,1">
                        <Ellipse Classes="dot" Classes.full="{Binding IsFull}" Classes.partial="{Binding IsPartial}" Classes.none="{Binding IsNone}" />
                        <TextBlock Grid.Column="1" Text="{Binding Viewer}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted small" TextWrapping="Wrap"
                   Text="{l:T 'Grün: ja, orange: teilweise, rot: nein.'}" />
        <TextBlock Classes="muted small" Text="{x:Static vm:CodecInfo.Stand}" />
    </StackPanel>
</UserControl>
