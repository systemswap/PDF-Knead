<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:PdfKnead.Localization"
        x:Class="PdfKnead.Views.SaveChangesWindow"
        Title="{l:T 'Änderungen speichern?'}"
        Icon="/Assets/app.ico"
        Width="460" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}">
                <PathIcon Data="{StaticResource Icon.Save}" Width="20" Height="20"
                          Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock FontWeight="SemiBold" FontSize="15" Text="{l:T 'Änderungen speichern?'}" />
                <TextBlock Name="FileText" Classes="muted" TextTrimming="CharacterEllipsis" MaxWidth="360" />
            </StackPanel>
        </StackPanel>

        <TextBlock TextWrapping="Wrap"
                   Text="{l:T 'Das Dokument wurde geändert. Ohne Speichern gehen die Änderungen verloren.'}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Content="{l:T 'Abbrechen'}" Click="OnCancel" IsCancel="True" />
            <Button Content="{l:T 'Nicht speichern'}" Click="OnDiscard" />
            <Button Classes="primary" Content="{l:T 'Speichern'}" Click="OnSave" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
