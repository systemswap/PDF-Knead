<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:PdfKnead.Localization"
        xmlns:vm="using:PdfKnead.ViewModels"
        x:Class="PdfKnead.Views.LicenseWindow"
        x:DataType="vm:LicenseViewModel"
        Title="{Binding Title}"
        Icon="/Assets/app.ico"
        Width="600" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!-- Lizenzschlüssel eintragen und, wenn eine lizenzpflichtige Funktion gesperrt ist, warum (LICENSE § 3); nichts wird gesendet außer
         beim Klick auf „Nach Verlängerung suchen“ (die signierte Versionsdatei) und „Projektseite öffnen“ (im Browser des Systems) -->
    <StackPanel Margin="24" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}">
                <PathIcon Data="{StaticResource Icon.LockClosed}" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15" Text="{Binding Title}" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Text="{Binding LockedText}" IsVisible="{Binding IsLocked}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Status}" />

        <StackPanel Spacing="6">
            <TextBlock Text="{l:T 'Lizenzschlüssel'}" FontWeight="SemiBold" />
            <TextBox Name="KeyBox" Text="{Binding Key}" FontFamily="{DynamicResource MonoFont}" TextWrapping="Wrap"
                     PlaceholderText="XXXXX-XXXXX-XXXXX-…" />
            <StackPanel Spacing="6" IsVisible="{Binding NeedsEmail}">
                <TextBlock Text="{l:T 'E-Mail-Adresse, für die der Schlüssel ausgestellt wurde'}" />
                <TextBox Text="{Binding Email}" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Text="{Binding KeyText}" Classes.muted="{Binding !KeyFine}" FontSize="12" />
        </StackPanel>

        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="{l:T 'Lizenzen gibt es beim Rechteinhaber über die Projektseite auf GitHub. Ein Schlüssel gilt ohne zeitliche Grenze für alle Versionen bis zum Ende seines Update-Zeitraums.'}" />

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLocked}">
            <Button Content="{l:T 'Nach Verlängerung suchen'}" Command="{Binding SearchExtensionCommand}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ExtensionText}" />
        </StackPanel>

        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,4,0,0">
            <Button Grid.Column="0" Content="{l:T 'Projektseite öffnen'}" Command="{Binding OpenProjectCommand}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="{l:T 'Nutzungsart ändern'}" Command="{Binding ChangeUsageCommand}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Button Content="{l:T 'Schließen'}" Click="OnClose" IsCancel="True" />
                <Button Classes="primary" Content="{l:T 'Eintragen'}" Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
