<UserControl xmlns="https://github.com/avaloniaui"
             Background="{DynamicResource SurfaceAltBrush}"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:PdfKnead.Localization"
             xmlns:vm="using:PdfKnead.ViewModels"
             x:Class="PdfKnead.Views.HiddenContentPanel"
             x:DataType="vm:DocumentViewModel">
    <!-- Verborgenes schwärzen (KONZEPT §5.18): oben Übersicht und Springen, darunter je eine Karte für die Stellen außerhalb des
         Blattes und auf dem Blatt, jede mit „Alle“; ein Häkchen markiert zum Schwärzen, ein Doppelklick zeigt den ganzen Text -->
    <UserControl.Styles>
        <StyleInclude Source="avares://PdfKnead.Ui/Styles/PropertyPanel.axaml" />
        <Style Selector="Button.bannerClose">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="Button.bannerClose PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.step">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="7,5" />
        </Style>
        <Style Selector="Button.step PathIcon">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
        </Style>
        <Style Selector="Border.count">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.count TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.meta.outside">
            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
        </Style>
        <Style Selector="ListBox.spots">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="-6,8,-6,0" />
        </Style>
        <Style Selector="ListBox.spots ListBoxItem">
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBox.spots ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="ListBox.spots ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:HiddenSpotRow">
            <Grid ColumnDefinitions="Auto,*">
                <CheckBox IsChecked="{Binding IsMarked}" IsEnabled="{Binding !IsUnderBar}" VerticalAlignment="Top" Margin="0,0,4,0" MinWidth="0"
                          AutomationProperties.Name="{l:T 'Zum Schwärzen markieren'}">
                    <ToolTip.Tip><l:T Text="Zum Schwärzen markieren" /></ToolTip.Tip>
                </CheckBox>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Background="Transparent">
                    <ToolTip.Tip><l:T Text="Doppelklick oder Eingabetaste: ganzen Text zeigen" /></ToolTip.Tip>
                    <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="meta" Classes.outside="{Binding IsOutside}" Text="{Binding Place}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Border Classes="propBanner">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="bannerIcon"><PathIcon Data="{StaticResource Icon.EyeOff}" /></Border>
                <TextBlock Grid.Column="1" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Text="{l:T 'Verborgener Inhalt'}" />
                <Button Grid.Column="2" Classes="bannerClose" VerticalAlignment="Center"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RedactHiddenCommand, FallbackValue={x:Null}}"
                        AutomationProperties.Name="{l:T 'Verborgenes schwärzen beenden'}">
                    <ToolTip.Tip><l:T Text="Verborgenes schwärzen beenden (Esc)" /></ToolTip.Tip>
                    <PathIcon Data="{StaticResource Icon.Dismiss}" />
                </Button>
            </Grid>
        </Border>

        <!-- Übersicht: was gefunden ist, wie es weitergeht, Springen von Stelle zu Stelle -->
        <Border Grid.Row="1" Classes="propCard">
            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding HiddenStatus}" TextWrapping="Wrap" />
                    <TextBlock Classes="hint" Text="{l:T 'Markierte Stellen entfernt erst „Schwärzungen anwenden“ — nur den verborgenen Text, ohne schwarzen Balken.'}" />
                </StackPanel>
                <!-- Der ganze erkannte Text auf einmal zum Lesen (KONZEPT §5.6): ob er Geschwärztes enthält -->
                <Button HorizontalAlignment="Left" IsVisible="{Binding HasOcrSpots}" Content="{l:T 'OCR anzeigen'}"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowOcrCommand, FallbackValue={x:Null}}">
                    <ToolTip.Tip><l:T Text="Den ganzen unsichtbaren Text der Texterkennung in einem Fenster lesen, nach Seiten — etwa um zu sehen, ob er Namen enthält, die geschwärzt werden sollen" /></ToolTip.Tip>
                </Button>
                <Border Classes="segment" IsEnabled="{Binding HasHiddenSpots}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="step" Command="{Binding PreviousHiddenSpotCommand}" AutomationProperties.Name="{l:T 'Vorherige Stelle'}">
                            <ToolTip.Tip><l:T Text="Vorherige Stelle" /></ToolTip.Tip>
                            <PathIcon Data="{StaticResource Icon.ChevronUp}" />
                        </Button>
                        <TextBlock MinWidth="104" TextAlignment="Center" VerticalAlignment="Center" FontSize="12.5" Text="{Binding HiddenPosition}" />
                        <Button Classes="step" Command="{Binding NextHiddenSpotCommand}" AutomationProperties.Name="{l:T 'Nächste Stelle'}">
                            <ToolTip.Tip><l:T Text="Nächste Stelle" /></ToolTip.Tip>
                            <PathIcon Data="{StaticResource Icon.ChevronDown}" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Außerhalb des Blattes: meist wenige, darum eine kurze Liste -->
        <Border Grid.Row="2" Classes="propCard" IsVisible="{Binding HasHiddenOutside}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Classes="propHeader">
                        <Border Classes="propBadge"><PathIcon Data="{StaticResource Icon.ArrowUpRight}" /></Border>
                        <TextBlock Classes="propTitle" Text="{l:T 'Außerhalb des Blattes'}" />
                        <Border Classes="count"><TextBlock Text="{Binding HiddenOutside.Count}" /></Border>
                    </StackPanel>
                    <CheckBox Grid.Column="2" Content="{l:T 'Alle'}" IsChecked="{Binding AllOutsideMarked}" VerticalAlignment="Center"
                              AutomationProperties.Name="{l:T 'Alles außerhalb schwärzen'}">
                        <ToolTip.Tip><l:T Text="Alles außerhalb schwärzen: alle Stellen außerhalb des Blattes markieren (noch einmal: alle Markierungen zurücknehmen)" /></ToolTip.Tip>
                    </CheckBox>
                </Grid>
                <ListBox Name="OutsideList" Classes="spots" MaxHeight="168" ItemsSource="{Binding HiddenOutside}" SelectedItem="{Binding SelectedOutsideRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" DoubleTapped="OnSpotDoubleTapped" />
            </DockPanel>
        </Border>

        <!-- Auf dem Blatt: füllt den Rest -->
        <Border Grid.Row="3" Classes="propCard" VerticalAlignment="Stretch">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Classes="propHeader">
                        <Border Classes="propBadge"><PathIcon Data="{StaticResource Icon.DocumentOnePage}" /></Border>
                        <TextBlock Classes="propTitle" Text="{l:T 'Auf dem Blatt'}" />
                        <Border Classes="count"><TextBlock Text="{Binding HiddenOnPage.Count}" /></Border>
                    </StackPanel>
                    <CheckBox Grid.Column="2" Content="{l:T 'Alle'}" IsChecked="{Binding AllOnPageMarked}" IsEnabled="{Binding CanMarkAllOnPage}"
                              VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Alle auf dem Blatt markieren'}">
                        <ToolTip.Tip><l:T Text="Alle Stellen auf dem Blatt markieren (noch einmal: zurücknehmen) — unsichtbaren OCR-Text nur einzeln, sonst ist das Dokument danach nicht mehr durchsuchbar" /></ToolTip.Tip>
                    </CheckBox>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,8,0,0" Text="{l:T 'Auf den Seiten ist nichts verborgen.'}"
                           IsVisible="{Binding !HasHiddenOnPage}" />
                <ListBox Name="OnPageList" Classes="spots" ItemsSource="{Binding HiddenOnPage}" SelectedItem="{Binding SelectedOnPageRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" DoubleTapped="OnSpotDoubleTapped" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
