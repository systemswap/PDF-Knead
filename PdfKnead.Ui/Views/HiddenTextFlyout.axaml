<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:PdfKnead.Localization"
             xmlns:vm="using:PdfKnead.ViewModels"
             x:Class="PdfKnead.Views.HiddenTextFlyout"
             x:DataType="vm:DocumentViewModel"
             AutomationProperties.Name="{l:T 'Verborgener Text'}">
    <!-- Ganzer Text der gewählten verborgenen Stelle (Doppelklick auf eine Zeile im Bereich „Verborgener Inhalt“, KONZEPT §5.18);
         folgt der gewählten Zeile, ein Klick woanders oder Esc schließt -->
    <UserControl.Styles>
        <Style Selector="Button.flyoutClose">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Button.flyoutClose PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
    </UserControl.Styles>
    <Panel DataContext="{Binding SelectedHiddenRow}">
    <DockPanel Margin="16,14,10,14" x:DataType="vm:HiddenSpotRow">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,10,*,Auto">
            <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                <PathIcon Data="{StaticResource Icon.EyeOff}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                <TextBlock Name="PlaceText" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Place}" />
                <TextBlock Classes="muted" FontSize="12" Text="{Binding GlyphCountText}" />
            </StackPanel>
            <Button Grid.Column="3" Classes="flyoutClose" Command="{Binding $parent[UserControl].((vm:DocumentViewModel)DataContext).CloseHiddenTextCommand, FallbackValue={x:Null}}"
                    AutomationProperties.Name="{l:T 'Schließen'}">
                <ToolTip.Tip><l:T Text="Schließen (Esc)" /></ToolTip.Tip>
                <PathIcon Data="{StaticResource Icon.Dismiss}" />
            </Button>
        </Grid>

        <CheckBox DockPanel.Dock="Bottom" Margin="0,10,0,0" IsChecked="{Binding IsMarked}" IsEnabled="{Binding !IsUnderBar}" Content="{l:T 'Zum Schwärzen markieren'}" />
        <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="12" Margin="0,8,6,0" TextWrapping="Wrap" IsVisible="{Binding !CopyAllowed}"
                   Text="{l:T 'Das Dokument erlaubt kein Kopieren – der Text lässt sich nur lesen.'}" />

        <Border Margin="0,12,6,0" Padding="0" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}">
            <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Panel Margin="12,10">
                    <SelectableTextBlock Name="CopyableText" TextWrapping="Wrap" Text="{Binding FullText}" IsVisible="{Binding CopyAllowed}" />
                    <TextBlock Name="ReadOnlyText" TextWrapping="Wrap" Text="{Binding FullText}" IsVisible="{Binding !CopyAllowed}" />
                </Panel>
            </ScrollViewer>
        </Border>
    </DockPanel>
    </Panel>
</UserControl>
