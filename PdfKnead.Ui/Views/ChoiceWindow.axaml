<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:PdfKnead.Localization"
        x:Class="PdfKnead.Views.ChoiceWindow"
        Icon="/Assets/app.ico"
        MinWidth="480" MaxWidth="820" SizeToContent="WidthAndHeight"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!-- Eine Frage mit einer oder mehreren Antworten und einem Weg zurück (Zusammenführen, Reiter schließen, Messen …), wahlweise mit Häkchen -->
    <StackPanel Margin="24" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}">
                <PathIcon Name="HeadingIcon" Data="{StaticResource Icon.Merge}" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock Name="HeadingText" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" MaxWidth="380" />
        </StackPanel>
        <!-- Die Breite folgt den Knöpfen (lange Antworten); der Text bricht um, statt das Fenster breiter zu machen -->
        <TextBlock Name="MessageText" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
        <CheckBox Name="CheckBox" IsVisible="False" />
        <!-- Weg zurück links, die Antworten rechts davon, die vorgewählte ganz rechts -->
        <StackPanel Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Name="CancelButton" Content="{l:T 'Abbrechen'}" Click="OnCancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
