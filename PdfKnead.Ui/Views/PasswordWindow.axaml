<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:PdfKnead.Localization"
        x:Class="PdfKnead.Views.PasswordWindow"
        Title="{l:T 'Passwort'}"
        Icon="/Assets/app.ico"
        Width="420" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}">
                <PathIcon Data="{StaticResource Icon.LockClosed}" Width="20" Height="20"
                          Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Name="HeadingText" FontWeight="SemiBold" FontSize="15" Text="{l:T 'Geschützte PDF-Datei'}" />
                <TextBlock Name="FileText" Classes="muted" TextTrimming="CharacterEllipsis" MaxWidth="320" />
            </StackPanel>
        </StackPanel>

        <TextBox Name="PasswordBox" PasswordChar="•" RevealPassword="False"
                 PlaceholderText="{l:T 'Passwort'}" />
        <TextBlock Name="WrongText" IsVisible="False" Foreground="{DynamicResource DangerBrush}"
                   Text="{l:T 'Das Passwort ist falsch. Bitte noch einmal versuchen.'}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Content="{l:T 'Abbrechen'}" Click="OnCancel" IsCancel="True" />
            <Button Name="OkButton" Classes="primary" Content="{l:T 'Öffnen'}" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
