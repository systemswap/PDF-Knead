<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:PdfKnead.Localization"
        xmlns:c="using:PdfKnead.Controls"
        xmlns:vm="using:PdfKnead.ViewModels"
        x:Class="PdfKnead.Views.SplitWindow"
        x:DataType="vm:SplitViewModel"
        Title="{l:T 'Teilen'}"
        Icon="/Assets/app.ico"
        Width="1180" Height="780" MinWidth="760" MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Border.part">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="Border.part.dropTarget">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="Button.newPart">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
        </Style>
        <Style Selector="Button.newPart.dropTarget /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="*,340" RowDefinitions="*,Auto">
        <!-- Links: alle Seiten -->
        <Grid Grid.Column="0" Grid.Row="0" RowDefinitions="Auto,Auto,*">
            <StackPanel Grid.Row="0" Margin="20,18,20,4" Spacing="2">
                <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted" Text="{Binding SelectionText}" />
            </StackPanel>
            <DockPanel Grid.Row="1" Margin="20,6,20,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.ZoomOut}" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" />
                    <Slider Name="SizeSlider" Width="140" Minimum="70" Maximum="420" Value="150"
                            VerticalAlignment="Center" />
                    <PathIcon Data="{StaticResource Icon.ZoomIn}" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:T 'Alle'}" Click="OnAll" />
                    <Button Content="{l:T 'Keine'}" Click="OnNone" />
                    <TextBox Name="RangeBox" Width="160" PlaceholderText="{l:T 'Bereich, z. B. 1-3, 7'}" TextChanged="OnRangeChanged" />
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="2" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,1,0">
                <c:PageGridView Name="GridView" />
            </Border>
        </Grid>

        <!-- Rechts: die Teile -->
        <DockPanel Grid.Column="1" Grid.Row="0" Margin="16,18,16,0">
            <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
                <TextBlock Classes="section" Text="{l:T 'TEILE'}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock VerticalAlignment="Center" Text="{l:T 'Je Teil'}" />
                    <NumericUpDown Value="{Binding EveryPages}" Minimum="1" Maximum="100000" Increment="1" FormatString="0"
                                   Width="110" />
                    <TextBlock VerticalAlignment="Center" Text="{l:T 'Seiten'}" />
                    <Button Content="{l:T 'Aufteilen'}" Command="{Binding SplitEveryCommand}" />
                </StackPanel>
                <Button Content="{l:T 'An Lesezeichen teilen'}" Command="{Binding SplitAtBookmarksCommand}"
                        IsEnabled="{Binding HasOutline}" />
            </StackPanel>
            <ScrollViewer>
                <StackPanel Spacing="8" Margin="0,0,4,12">
                    <ItemsControl Name="PartList" ItemsSource="{Binding Parts}">
                        <!-- Virtualisiert: auch 3000 Teile (je 1 Seite) bauen nur die sichtbaren Karten -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SplitPartViewModel">
                                <Border Classes="part" Classes.dropTarget="{Binding IsDropTarget}" Margin="0,0,0,8" Tag="part">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="6" CornerRadius="3" Background="{Binding Brush}" Margin="0,0,10,0" />
                                        <Button DockPanel.Dock="Right" Classes="closeTab" VerticalAlignment="Top"
                                                Command="{Binding $parent[Window].((vm:SplitViewModel)DataContext).RemovePartCommand}"
                                                CommandParameter="{Binding}">
                                            <ToolTip.Tip><l:T Text="Teil entfernen (die Seiten bleiben im Dokument)" /></ToolTip.Tip>
                                            <PathIcon Data="{StaticResource Icon.Dismiss}" Width="10" Height="10" />
                                        </Button>
                                        <StackPanel Spacing="6">
                                            <TextBox Text="{Binding Name}">
                                                <ToolTip.Tip><l:T Text="Name des Teils = Dateiname" /></ToolTip.Tip>
                                            </TextBox>
                                            <TextBlock Classes="muted small" Text="{Binding Summary}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Pages}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PageViewModel">
                                                        <Button Classes="chip" Click="OnRemovePage">
                                                            <ToolTip.Tip><l:T Text="Seite aus dem Teil nehmen" /></ToolTip.Tip>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{Binding Number}" />
                                                                <PathIcon Data="{StaticResource Icon.Dismiss}" Width="7" Height="7" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Ablageziel: ausgewählte Seiten hierher ziehen (oder klicken) → neuer Teil -->
                    <Button Name="NewPartTarget" Classes="newPart" Command="{Binding AddPartCommand}">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource Icon.Add}" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{l:T 'Seiten hierher ziehen'}" HorizontalAlignment="Center" FontWeight="Medium" />
                            <TextBlock Classes="muted small" Text="{l:T 'neuer Teil aus der Auswahl'}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Unten -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:T 'Abbrechen'}" Click="OnCancel" IsCancel="True" />
                    <Button Classes="primary" Content="{l:T 'Teile speichern …'}" Command="{Binding SaveCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding IncludeRest}" Content="{l:T 'Nicht zugeordnete Seiten als eigenen Teil speichern'}" />
                    <TextBlock Foreground="{DynamicResource DangerBrush}" Text="{Binding Error}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
