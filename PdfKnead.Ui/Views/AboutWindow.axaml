<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:PdfKnead.Localization"
        xmlns:c="using:PdfKnead.Controls"
        xmlns:s="using:PdfKnead.Services"
        xmlns:vm="using:PdfKnead.ViewModels"
        x:Class="PdfKnead.Views.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Title="{l:T 'Über PDF-Knead'}"
        Icon="/Assets/app.ico"
        Width="920" Height="660" MinWidth="680" MinHeight="440"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <!-- the contact address as a quiet link in the accent colour -->
        <Style Selector="Button.contact">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.contact:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.contact:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>
    <DockPanel Margin="24">
        <!-- Program and version -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="14">
            <c:AppLogo Width="44" Height="44" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <SelectableTextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Classes="muted" Text="{l:T 'Läuft vollständig auf diesem Rechner und sendet keine Daten.'}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="muted" VerticalAlignment="Center" Text="{l:T 'Kontakt:'}" />
                    <Button Name="ContactButton" Classes="contact" VerticalAlignment="Center" Click="OnContact"
                            ToolTip.Tip="{l:T 'E-Mail schreiben'}" AutomationProperties.Name="{l:T 'Kontakt per E-Mail'}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Name="CopyContactItem" Header="{l:T 'Adresse kopieren'}" Click="OnCopyContact" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <TextBlock Name="ContactAddress" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,16,0,0" MinWidth="96" Content="{l:T 'Schließen'}"
                IsDefault="True" IsCancel="True" Click="OnClose" />

        <Grid ColumnDefinitions="260,16,*" Margin="0,20,0,0">
            <Border Classes="card" Padding="4">
                <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:T 'Lizenzen'}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="s:LicenseTexts+Entry">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Column="2" Classes="card" Padding="0">
                <ScrollViewer Name="TextScroller">
                    <SelectableTextBlock Margin="16,12" FontSize="12" TextWrapping="Wrap" Text="{Binding Text}"
                                         FontFamily="Consolas, Liberation Mono, monospace" AutomationProperties.Name="{l:T 'Lizenztext'}" />
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
