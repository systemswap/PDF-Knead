        <StreamGeometry x:Key="Support.Heart">M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.1 0 3.6 1.1 4.3 2.4.7-1.3 2.2-2.4 4.3-2.4 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z</StreamGeometry>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Button.support">
            <Setter Property="Foreground" Value="#2A1A05" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#F7BD6A" />
                    <GradientStop Offset="1" Color="#F2A541" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.support:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#2A1A05" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#F9C77E" />
                    <GradientStop Offset="1" Color="#F4AE52" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.support:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#2A1A05" />
            <Setter Property="Background" Value="#E89A35" />
        </Style>
        <Style Selector="Button.later">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#47FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.later:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
        </Style>
        <Style Selector="Button.later:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="Background" Value="#1AFFFFFF" />
        </Style>
        <!-- the contact address: quiet like the line about the invoice, warm when pointed at -->
        <Style Selector="Button.contact">
            <Setter Property="Foreground" Value="#9FB3CC" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.contact Path">
            <Setter Property="Stroke" Value="#9FB3CC" />
        </Style>
        <Style Selector="Button.contact:pointerover Path">
            <Setter Property="Stroke" Value="#F2A541" />
        </Style>
        <Style Selector="Button.contact:pressed Path">
            <Setter Property="Stroke" Value="#F7BD6A" />
        </Style>
        <Style Selector="Button.contact:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#F2A541" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.contact:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#F7BD6A" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Panel>
        <Panel.Background>
            <LinearGradientBrush StartPoint="33%,0%" EndPoint="67%,100%">
                <GradientStop Offset="0" Color="#0B1F3A" />
                <GradientStop Offset="1" Color="#163F73" />
            </LinearGradientBrush>
        </Panel.Background>
        <!-- the fine diagonal -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#002B6CB0" />
                    <GradientStop Offset="0.62" Color="#002B6CB0" />
                    <GradientStop Offset="0.62" Color="#382B6CB0" />
                    <GradientStop Offset="0.64" Color="#382B6CB0" />
                    <GradientStop Offset="0.64" Color="#002B6CB0" />
                    <GradientStop Offset="1" Color="#002B6CB0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <!-- a soft glow at the bottom right -->
        <Ellipse Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-60,-80" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#592B6CB0" />
                    <GradientStop Offset="0.7" Color="#002B6CB0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel Margin="34,30,34,26">
            <Viewbox Height="34" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="PDF-Knead">
                <!-- the outlines stand on the baseline y = 0 and reach up to −94 at a size of 100: moved down into the box -->
                <Canvas Name="Wordmark" Width="575" Height="108">
                    <Canvas.Effect>
                        <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="18" Color="#78AAFF" Opacity="0.35" />
                    </Canvas.Effect>
                    <Canvas Canvas.Top="96">
                        <Path Data="{StaticResource Wordmark.Pdf}" Fill="#F4F7FB" />
                        <Path Data="{StaticResource Wordmark.Hyphen}" Fill="#F2A541" />
                        <Path Data="{StaticResource Wordmark.Knead}" Fill="#F4F7FB" />
                    </Canvas>
                </Canvas>
            </Viewbox>

            <TextBlock Margin="0,18,0,0" FontSize="28" FontWeight="Bold" Foreground="#F4F7FB" TextWrapping="Wrap"
                       Text="{l:T 'Vielen Dank, dass Sie PDF-Knead nutzen.'}" />

            <Grid ColumnDefinitions="*,26,250" Margin="0,18,0,0">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="16" LineHeight="25.6" Foreground="#F4F7FB" TextWrapping="Wrap"
                               Text="{l:T 'Ich hoffe, es erleichtert Ihnen die Arbeit mit Ihren Dokumenten.'}" />
                    <TextBlock FontSize="15" LineHeight="24" Foreground="#C9D6E8" TextWrapping="Wrap"
                               Text="{l:T 'Hinter PDF-Knead steht kein Konzern und auch kein großer Sponsor. Es gibt keine Werbung, es werden keine Nutzungsdaten erhoben und schon gar nicht verkauft, um dieses Projekt zu finanzieren.'}" />
                    <TextBlock FontSize="15" LineHeight="24" Foreground="#C9D6E8" TextWrapping="Wrap"
                               Text="{l:T 'Mit Ihrer Unterstützung tragen Sie dazu bei, dass dies auch in Zukunft so sein wird, und zeigen gleichzeitig Ihre Wertschätzung für PDF-Knead. Dafür danke ich Ihnen herzlich.'}" />
                </StackPanel>

                <!-- documents folded into paper planes, rising into a warm evening sky (the shapes of the preview, 250 × 300) -->
                <Border Grid.Column="2" Width="250" Height="300" VerticalAlignment="Top" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="#1FFFFFFF" BorderThickness="1" BoxShadow="0 10 30 0 #59000000" AutomationProperties.AccessibilityView="Raw">
                    <Canvas Width="250" Height="300">
                        <Rectangle Width="250" Height="300">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Offset="0" Color="#132F57" />
                                    <GradientStop Offset="0.55" Color="#3D5F97" />
                                    <GradientStop Offset="0.8" Color="#E59A5C" />
                                    <GradientStop Offset="1" Color="#F6C47C" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Ellipse Canvas.Left="90" Canvas.Top="162" Width="140" Height="140">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="#FFF2CF" />
                                    <GradientStop Offset="0.45" Color="#FFD58A" />
                                    <GradientStop Offset="1" Color="#00FFD58A" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Canvas.Left="138" Canvas.Top="210" Width="44" Height="44" Fill="#FFF0C8" />
                        <Ellipse Canvas.Left="38.8" Canvas.Top="38.8" Width="2.4" Height="2.4" Fill="#CCFFFFFF" />
                        <Ellipse Canvas.Left="89.1" Canvas.Top="21.1" Width="1.8" Height="1.8" Fill="#CCFFFFFF" />
                        <Ellipse Canvas.Left="203.9" Canvas.Top="32.9" Width="2.2" Height="2.2" Fill="#CCFFFFFF" />
                        <Ellipse Canvas.Left="227.2" Canvas.Top="75.2" Width="1.6" Height="1.6" Fill="#CCFFFFFF" />
                        <Ellipse Canvas.Left="17.2" Canvas.Top="95.2" Width="1.6" Height="1.6" Fill="#CCFFFFFF" />
                        <Ellipse Canvas.Left="129.3" Canvas.Top="57.3" Width="1.4" Height="1.4" Fill="#CCFFFFFF" />
                        <Path Data="M0,250 C50,228 95,236 140,252 S220,262 250,246 L250,300 L0,300 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Offset="0" Color="#2D5285" />
                                    <GradientStop Offset="1" Color="#1B3660" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Path Data="M0,268 C60,252 110,262 160,274 S230,282 250,272 L250,300 L0,300 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Offset="0" Color="#22406B" />
                                    <GradientStop Offset="1" Color="#14294A" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- a sheet still lying in the grass, the start of the flight -->
                        <Canvas RenderTransformOrigin="0%,0%">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="-8" />
                                    <TranslateTransform X="36" Y="262" />
                                </TransformGroup>
                            </Canvas.RenderTransform>
                            <Rectangle Width="30" Height="38" RadiusX="2" RadiusY="2" Fill="#F4F7FB" />
                            <Path Data="M22,0 L30,8 L22,8 Z" Fill="#CDD8E8" />
                            <Line StartPoint="5,13" EndPoint="24,13" Stroke="#9FB2CC" StrokeThickness="1.4" StrokeLineCap="Round" />
                            <Line StartPoint="5,19" EndPoint="24,19" Stroke="#9FB2CC" StrokeThickness="1.4" StrokeLineCap="Round" />
                            <Line StartPoint="5,25" EndPoint="18,25" Stroke="#9FB2CC" StrokeThickness="1.4" StrokeLineCap="Round" />
                        </Canvas>

                        <!-- trails (dashes in units of the stroke: 3 and 5 at 1.3) -->
                        <Path Data="M62,250 C80,205 70,175 110,150" Stroke="#8CFFFFFF" StrokeThickness="1.3" StrokeDashArray="2.3,3.85" StrokeLineCap="Round" />
                        <Path Data="M120,205 C140,170 150,140 180,112" Stroke="#8CFFFFFF" StrokeThickness="1.3" StrokeDashArray="2.3,3.85" StrokeLineCap="Round" />
                        <Path Data="M70,140 C90,110 110,90 150,70" Stroke="#8CFFFFFF" StrokeThickness="1.3" StrokeDashArray="2.3,3.85" StrokeLineCap="Round" />

                        <!-- paper planes -->
                        <Canvas RenderTransformOrigin="0%,0%">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="-24" />
                                    <TranslateTransform X="108" Y="132" />
                                </TransformGroup>
                            </Canvas.RenderTransform>
                            <Path Data="M0,10 L34,0 L12,14 Z" Fill="#FFFFFF" />
                            <Path Data="M12,14 L34,0 L16,22 Z" Fill="#D7E1EF" />
                            <Path Data="M0,10 L12,14 L10,18 Z" Fill="#B9C8DD" />
                        </Canvas>
                        <Canvas RenderTransformOrigin="0%,0%">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                    <RotateTransform Angle="-30" />
                                    <TranslateTransform X="176" Y="94" />
                                </TransformGroup>
                            </Canvas.RenderTransform>
                            <Path Data="M0,10 L34,0 L12,14 Z" Fill="#FFFFFF" />
                            <Path Data="M12,14 L34,0 L16,22 Z" Fill="#D7E1EF" />
                            <Path Data="M0,10 L12,14 L10,18 Z" Fill="#B9C8DD" />
                        </Canvas>
                        <Canvas RenderTransformOrigin="0%,0%">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.62" ScaleY="0.62" />
                                    <RotateTransform Angle="-18" />
                                    <TranslateTransform X="148" Y="56" />
                                </TransformGroup>
                            </Canvas.RenderTransform>
                            <Path Data="M0,10 L34,0 L12,14 Z" Fill="#FFF6E6" />
                            <Path Data="M12,14 L34,0 L16,22 Z" Fill="#F2DCB8" />
                            <Path Data="M0,10 L12,14 L10,18 Z" Fill="#E3C596" />
                        </Canvas>
                    </Canvas>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Name="SupportButton" Classes="support" Click="OnSupport">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Data="{StaticResource Support.Heart}" Fill="#2A1A05" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T 'Unterstützen'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Name="LaterButton" Classes="later" Click="OnLater" IsCancel="True" Content="{l:T 'Vielleicht später'}" />
                </StackPanel>
                <!-- the contact address, under the picture and flush with its right edge -->
                <Button Name="ContactButton" Grid.Column="1" Classes="contact" VerticalAlignment="Center" Margin="0,0,-6,0" Click="OnContact"
                        ToolTip.Tip="{l:T 'E-Mail schreiben'}" AutomationProperties.Name="{l:T 'Kontakt per E-Mail'}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Name="CopyContactItem" Header="{l:T 'Adresse kopieren'}" Click="OnCopyContact" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Data="{StaticResource Support.Mail}" StrokeThickness="1.5"
                              StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Name="ContactAddress" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Panel>
</Window>
