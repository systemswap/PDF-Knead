<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:PdfKnead.Localization"
        x:Class="PdfKnead.Views.SupportWindow"
        Title="{l:T 'PDF-Knead unterstützen'}"
        Icon="/Assets/app.ico"
        Width="820" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#0B1F3A" RequestedThemeVariant="Dark">
    <!-- The window that invites support (decided on 21.11.2026, text and look as in docs/entwurf/unterstuetzen-fenster.html): after a
         successful save, 30 days after the first start at the earliest, then after 9 months („Vielleicht später“) or 18 months
         („Unterstützen“). Its own look in both themes: a deep blue with one warm button. The page opens only on the click, in the browser of
         the system; nothing is sent. -->
    <Window.Resources>
